# title: Floats print the shortest text that round-trips, switching to exponents when large or small
# output: 1.5
# output: 1e+06
# output: 0.00001
# output: 9e-06
# output: 1.2345678e+07
# output: 0.1
# output: -0.0
# output: 3.0

print(1.5)
print(1e6)
print(1e-5)
print(9e-6)
print(12345678.0)
print(0.1)
print(-0.0)
print(float(3))
