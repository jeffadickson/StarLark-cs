10 REM FOUR PERIODS OF A SINE WAVE, 60 COLUMNS BY 15 ROWS
20 PI=3.14159265
30 DIM Y(59)
40 FOR X=0 TO 59
50 Y(X)=INT(7-7*SIN(X*2*PI/15)+.5)
60 NEXT X
70 FOR R=0 TO 14
80 FOR X=0 TO 59
90 IF Y(X)=R THEN PRINT "*";:GOTO 130
100 IF R=7 THEN PRINT "-";:GOTO 130
110 PRINT " ";
130 NEXT X
140 PRINT
150 NEXT R
160 PRINT "4 PERIODS OF SIN(X), 15 COLUMNS EACH"
