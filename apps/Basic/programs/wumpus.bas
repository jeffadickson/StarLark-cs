10 REM A SMALL HUNT: FIND THE TREASURE ON A 5 BY 5 GRID, GUIDED BY HOT AND COLD
20 RANDOM
30 TX=INT(RND(5)):TY=INT(RND(5))-1
40 TX=TX-1
50 PRINT "THE TREASURE IS HIDDEN ON A 5 BY 5 GRID. ROWS AND COLUMNS ARE 1 TO 5."
60 T=0
70 INPUT "COLUMN,ROW";X,Y
80 T=T+1
90 D=ABS(X-TX-1)+ABS(Y-TY-1)
100 IF D=0 THEN 150
110 IF D<=1 THEN PRINT "BURNING HOT":GOTO 70
120 IF D<=3 THEN PRINT "WARM":GOTO 70
130 PRINT "COLD":GOTO 70
150 PRINT "FOUND IT IN";T;"TRIES"
